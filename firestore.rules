rules_version = '2';
// Входа в приложении нет: читать и менять может любой, у кого есть ссылка,
// но только эти документы, только нужные поля и без удаления.
service cloud.firestore {
  match /databases/{database}/documents {
    match /app/dishwasher {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['date', 'unloadedAt', 'loadedAt'])
                   && request.resource.data.date is string;
    }
    match /app/menu {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['week', 'cats'])
                   && request.resource.data.week is map
                   && request.resource.data.cats is list
                   && request.resource.data.cats.size() <= 30;
    }
    match /app/lists {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['shop', 'todo', 'ready'])
                   && request.resource.data.get('shop', []) is list
                   && request.resource.data.get('todo', []) is list
                   && request.resource.data.get('shop', []).size() <= 200
                   && request.resource.data.get('todo', []).size() <= 200
                   && request.resource.data.get('ready', {}) is map;
    }
  }
}
